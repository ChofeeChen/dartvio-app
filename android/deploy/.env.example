# 复制成 .env 后填入真实值：cp .env.example .env
# .env 不要提交到版本库

# 解析到这台服务器的域名（境外节点无需备案）
DOMAIN=api.yourdomain.top

POSTGRES_DB=dartvio
POSTGRES_USER=postgres
# 数据库超级用户密码，换成一个强密码
POSTGRES_PASSWORD=change-me-db-password

# PostgREST 用来连库的登录角色密码，与上面不同即可
AUTHENTICATOR_PASSWORD=change-me-authenticator-password

# PostgREST 校验 JWT 的密钥，随便一个 32 位以上的随机串
# 生成：openssl rand -base64 32
PGRST_JWT_SECRET=change-me-jwt-secret
