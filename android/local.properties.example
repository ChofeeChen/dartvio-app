# 复制为 local.properties 后填入真值。**local.properties 不入库**（已在 .gitignore）。
#
# 匿名统计后端（Supabase）
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
# 可选：让 debug 包也上报（默认关，避免开发数据污染）
dartvio.telemetry.debug=false

# 在线对战后端（自建后端，蜂窝可达）。不单独配时回退到统计那套。
ONLINE_URL=https://<your-online-backend>
ONLINE_ANON_KEY=<anon-key>
